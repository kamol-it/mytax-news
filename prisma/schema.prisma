// MyTax.uz — новостной портал о налогах
// PostgreSQL + Prisma. Мультиязычные поля: uz / ru / en.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id       String @id @default(cuid())
  email    String @unique
  name     String
  password String
  /// "ADMIN" | "EDITOR"
  role      String    @default("EDITOR")
  createdAt DateTime  @default(now())
  articles  Article[]
}

model Category {
  id       String    @id @default(cuid())
  slug     String    @unique
  nameUz   String
  nameRu   String
  nameEn   String
  position Int       @default(0)
  articles Article[]
}

model Article {
  id    String @id @default(cuid())
  slug  String @unique

  titleUz String
  titleRu String
  titleEn String

  // Короткий анонс для карточек и meta description
  excerptUz String @default("")
  excerptRu String @default("")
  excerptEn String @default("")

  // Тело новости в HTML (редактор в админке)
  bodyUz String @default("")
  bodyRu String @default("")
  bodyEn String @default("")

  coverImage String? // путь /uploads/xxx.jpg или ссылка на Vercel Blob
  /// Размеры обложки: нужны, чтобы вертикальные инфографики не обрезались
  coverWidth  Int?
  coverHeight Int?
  videoUrl    String? // загруженный файл или ссылка на YouTube

  published   Boolean   @default(false)
  featured    Boolean   @default(false)
  publishedAt DateTime?
  views       Int       @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  authorId String?
  author   User?   @relation(fields: [authorId], references: [id], onDelete: SetNull)

  media Media[]

  @@index([published, publishedAt])
  @@index([categoryId])
}

/// Обращение из «Спроси консультанта»: ветка с историей сообщений.
model Question {
  id String @id @default(cuid())
  /// Секретный код в ссылке — по нему посетитель открывает свою ветку без регистрации.
  /// Nullable: у вопросов, созданных до появления веток, кода ещё нет.
  token String? @unique

  name    String
  contact String
  topic   String @default("")
  locale  String @default("ru")

  /// Текст первого вопроса из старой формы. Новые обращения пишут в QuestionMessage;
  /// поле оставлено, чтобы не потерять уже присланные вопросы.
  body String @default("")

  answered      Boolean  @default(false)
  closed        Boolean  @default(false)
  lastMessageAt DateTime @default(now())
  createdAt     DateTime @default(now())

  /// Публикация в разделе «Вопрос-ответ»: имя и контакт не показываются
  published   Boolean   @default(false)
  publicSlug  String?   @unique
  publicTitle String    @default("")
  publishedAt DateTime?

  messages QuestionMessage[]

  @@index([answered, lastMessageAt])
  @@index([published, publishedAt])
}

/// Сообщение в ветке: от посетителя или от консультанта.
model QuestionMessage {
  id     String @id @default(cuid())
  /// "visitor" | "consultant"
  author String
  body   String

  authorName String   @default("")
  createdAt  DateTime @default(now())

  questionId String
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([questionId, createdAt])
}

/// Настройки сайта в виде ключ-значение: ссылки на соцсети и подобное.
model Setting {
  key       String   @id
  value     String   @default("")
  updatedAt DateTime @updatedAt
}

/// Подписки браузеров на push-уведомления о новых новостях.
model PushSubscription {
  id        String   @id @default(cuid())
  endpoint  String   @unique
  p256dh    String
  auth      String
  locale    String   @default("uz")
  /// Подписка сотрудника: на неё уходят уведомления о новых вопросах
  admin Boolean @default(false)
  /// Подписка посетителя на ответ в конкретной ветке
  questionToken String   @default("")
  userAgent     String   @default("")
  createdAt DateTime @default(now())
}

/// Статические страницы: «О нас», «Контакты», «Реклама» и подобные.
model Page {
  id   String @id @default(cuid())
  slug String @unique

  titleUz String
  titleRu String
  titleEn String

  bodyUz String @default("")
  bodyRu String @default("")
  bodyEn String @default("")

  published Boolean @default(true)
  /// Показывать в верхнем меню; в подвале страница выводится всегда
  inHeader Boolean @default(true)
  position Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Media {
  id        String   @id @default(cuid())
  url       String
  filename  String
  mimeType  String
  size      Int
  kind      String // "image" | "video"
  width     Int?
  height    Int?
  createdAt DateTime @default(now())

  articleId String?
  article   Article? @relation(fields: [articleId], references: [id], onDelete: SetNull)
}

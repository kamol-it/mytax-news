# nginx для MYTAX.uz: HTTPS наружу, Node на 127.0.0.1:3000 внутри.
# Скопировать в /etc/nginx/sites-available/mytax.uz и включить символьной ссылкой.

server {
    listen 80;
    listen [::]:80;
    server_name mytax.uz www.mytax.uz;

    # certbot подставит сюда редирект на HTTPS после выпуска сертификата
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name mytax.uz www.mytax.uz;

    ssl_certificate     /etc/letsencrypt/live/mytax.uz/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/mytax.uz/privkey.pem;

    # Загрузка видео: без этого файлы больше 1 МБ отбиваются самим nginx
    client_max_body_size 200m;
    client_body_timeout 300s;

    # Ответ Next.js может идти долго при первой сборке страницы
    proxy_read_timeout 300s;
    proxy_send_timeout 300s;

    # Статика Next и загруженные файлы отдаём напрямую, минуя Node
    location /_next/static/ {
        alias /var/www/mytax/.next/static/;
        access_log off;
        expires 365d;
        add_header Cache-Control "public, immutable";
    }

    location /uploads/ {
        alias /var/www/mytax/public/uploads/;
        access_log off;
        expires 30d;
        # Загруженный файл не должен исполняться как скрипт
        add_header X-Content-Type-Options "nosniff";
    }

    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;

        # Реальный IP посетителя: по нему работает ограничение частоты запросов.
        # Без этих заголовков лимит станет общим для всех, и один спамер
        # заблокирует форму вопросов всему сайту.
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Host $host;

        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_cache_bypass $http_upgrade;
    }
}

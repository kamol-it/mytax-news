# systemd-юнит для MYTAX.uz.
# Скопировать в /etc/systemd/system/mytax.service, затем:
#   sudo systemctl daemon-reload && sudo systemctl enable --now mytax

[Unit]
Description=MYTAX.uz — новостной портал (Next.js)
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=simple
User=mytax
Group=mytax
WorkingDirectory=/var/www/mytax

# Переменные окружения лежат в отдельном файле с правами 600
EnvironmentFile=/var/www/mytax/.env
Environment=NODE_ENV=production
Environment=PORT=3000

# Слушаем только локальный адрес: снаружи сайт доступен через nginx.
# Если порт 3000 открыт в интернет, можно прислать поддельный X-Real-IP
# в обход nginx и обойти ограничение частоты запросов.
ExecStart=/usr/bin/npm start -- -H 127.0.0.1
Restart=always
RestartSec=5

# Ограничения доступа к системе
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/www/mytax/public/uploads /var/www/mytax/.next

StandardOutput=journal
StandardError=journal
SyslogIdentifier=mytax

[Install]
WantedBy=multi-user.target

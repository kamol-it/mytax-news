# nginx для поддомена админки (ADMIN_HOST=in.mytax.uz).
# Тот же Node на 127.0.0.1:3000: какой раздел показать, решает приложение по Host.
# Скопировать в /etc/nginx/sites-available/in.mytax.uz после выпуска сертификата:
#   certbot certonly --webroot -w /var/www/certbot -d in.mytax.uz
# HTTP (порт 80) для поддомена обслуживает default_server из nginx.conf.example.

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name in.mytax.uz;

    ssl_certificate     /etc/letsencrypt/live/in.mytax.uz/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/in.mytax.uz/privkey.pem;

    # Админку не индексируем
    add_header X-Robots-Tag "noindex, nofollow" always;

    client_max_body_size 200m;
    client_body_timeout 300s;
    proxy_read_timeout 300s;
    proxy_send_timeout 300s;

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location /_next/static/ {
        alias /var/www/mytax/.next/static/;
        access_log off;
        expires 365d;
        add_header Cache-Control "public, immutable";
    }

    location /uploads/ {
        alias /var/www/mytax/public/uploads/;
        access_log off;
        expires 30d;
        add_header X-Content-Type-Options "nosniff";
    }

    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Host $host;
    }
}
